# Contact form. Without both of these the endpoint refuses with 503 and tells
# the sender to email instead — it never answers "thanks" and drops the message.
# The enquiry is written to the server log either way, so nothing is lost.
RESEND_API_KEY=
CONTACT_TO=

# Optional. Must be a domain verified in the Resend account, or Resend rejects
# the send. Defaults to Resend's onboarding sender, which only delivers to the
# account owner's own address — fine for a smoke test, not for a live form.
RESEND_FROM=
